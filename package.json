{
  "name": "for-record",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --config oxfmt.config.ts --write .",
    "lint": "oxlint --config oxlint.config.ts --deny-warnings .",
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "wrangler dev --persist-to .wrangler/state --ip 127.0.0.1",
    "preview": "npm run build && npm start",
    "deploy": "npm run build && wrangler deploy",
    "create:db": "wrangler d1 create for-record --binding DB --update-config --config wrangler.jsonc",
    "migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@daypicker/react": "^10.0.2",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "7.22.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "otpauth": "^9.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
